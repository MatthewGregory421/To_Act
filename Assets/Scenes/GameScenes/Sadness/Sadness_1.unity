  narrationEvent:
    Guid:
      Data1: -356568994
      Data2: 1076544686
      Data3: 1617017728
      Data4: -827441235
    Path: event:/Narration/Narration Manager
  areaParameter: Music Selector
  narratorParameter: NarratorSelect
  areaValue: 3
  narrationDurations:
  - 3
  - 3.25
  - 4.6
  - 2.5
  - 3.5
  - 11.5
  - 4.5
  - 2.5
  - 4
  - 5
  - 2.5
  - 5.2
  - 5
  - 10
  - 5
  gapBetweenLines: 0.25
  narrationText: {fileID: 1345006405}
  narrationPanel: {fileID: 2050425256}
  narrationPanelImage: {fileID: 2050425259}
  narrationLines:
  - Now, here's the deal spark
  - I've got about 5 more minutes before this demo ends
  - So we're gonna do a little something called an exposition dump
  - These little guys are Emotions
  - Use the Up Arrow Key to launch some love at them
  - The Emotions with Blue cirlce's around them are super bummed, so you'll have
    to do a little grounding excersize before they are ready for love and acceptance,
    press the Down arrow in the air to do a grounding exercise
  - John's been pushing these emotions down for a long, long time
  - So no they are kicking up a fuse and overwelming him
  - And you cant fight emotions, thats just not how they work
  - So to deal with emotions, you've gotta accept them and thats what your doing
    when your giving them love
  - cause really, everything's ok
  - There is nothing wrong with being Sad or Angry or even full of Joy
  - Yes Spark that is called foreshadowing but we dont have time for things like
    that
  - Anyway make it all the way through area's like this and maybe accepting all these
    emotions will unlock new special abilities, maybe ones similar to the ones Emotions
    are using
  - Yes Spark, that is more foreshadowing but like i've said, we dont have time
  textFadeTime: 0.25
  panelMaxAlpha: 0.39215687
